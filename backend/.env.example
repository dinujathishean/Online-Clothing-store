# PostgreSQL connection string (Prisma reads this — do not commit real secrets)
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tshirt_business_db?schema=public"

# Server
PORT=5000
NODE_ENV=development

# JWT — use a long random string in production (e.g. openssl rand -base64 32)
JWT_SECRET=change_this_to_a_secure_random_string
JWT_EXPIRES_IN=7d

# Optional: comma-separated admin emails that receive role ADMIN on register
# ADMIN_EMAILS=owner@example.com

# CORS: frontend origin (e.g. http://localhost:5173)
# CLIENT_ORIGIN=http://localhost:5173
